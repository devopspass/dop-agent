# Slack Bot Token (xoxb-...)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Slack App-Level Token for Socket Mode (xapp-...)
SLACK_APP_TOKEN=xapp-your-app-token-here

# Your Slack User ID — leave empty on first run to discover it from logs
ALLOWED_USER_ID=

# DM channel ID to send the "✅ Bot started and ready." startup notification
# to. Leave empty to auto-reuse the last known DM channel from sessions.json
# (requires having DM'd the bot at least once before). The bot's token lacks
# im:write, so it can't open a fresh DM on its own — set this explicitly if
# sessions.json doesn't have one yet (channel IDs look like "D0123ABCDEF").
STARTUP_NOTIFY_CHANNEL=

# GitHub PAT with Copilot access (or use a secret reference in ~/.dop-agent/config.yaml)
COPILOT_GITHUB_TOKEN=

# Absolute Jira repository root for Copilot sessions (required; otherwise uses $HOME)
COPILOT_WORKDIR=

# Max seconds to wait for a Copilot response (default 120)
SESSION_TIMEOUT=120

# How Markdown tables are rendered in Slack: "image" (default, PNG via
# WeasyPrint) or "ascii" (box-drawing monospace code block)
TABLE_RENDER_MODE=image

# Local Whisper (openai-whisper) model used to transcribe voice/audio messages.
# One of: tiny, base, small, medium, large, turbo (or ".en" English-only variants).
# "large" (~3GB) gives the best accuracy; slower per-clip (~7s) and a bigger
# one-time download than "small"/"base".
# Downloaded from OpenAI's Azure CDN on first use, then cached and fully offline.
WHISPER_MODEL=large

# Default behavior once a voice/audio message finishes transcribing:
# "true" (default) — forward the transcript to the Copilot session
# automatically; the placeholder offers "Preview before sending" to opt out
# for a given message. "false" — wait for a manual "Send to Copilot" click;
# the placeholder offers "Auto-send when ready" to opt in for that message.
AUDIO_AUTO_SEND=true

# --- Web UI (browser front-end, Slack-like) ---
# Local, password-protected web UI served alongside the Slack bot in the same
# process. Bind is loopback-only by design (WEB_UI_HOST) — do not expose this
# to a LAN/the internet without adding real auth hardening first.
WEB_UI_HOST=127.0.0.1
WEB_UI_PORT=10818
# Hostname used when the bot generates links BACK into the Web UI
# (session_create's web_url, watch-fire "continue in session" links, etc.).
# Defaults to WEB_UI_HOST, but set this explicitly if you actually browse via
# a different hostname than WEB_UI_HOST (e.g. you browse "localhost" while
# WEB_UI_HOST stays "127.0.0.1" for the loopback-only bind) — otherwise those
# generated links are a different browser origin than the one you're logged
# into, so they silently open in a new tab and ask for the password again.
WEB_UI_PUBLIC_HOST=localhost
# REQUIRED to log in at all — leave unset and the web UI refuses every login.
WEB_UI_PASSWORD=
# Signs the login cookie. Set a fixed random value so logins survive bot
# restarts (otherwise a new random secret is generated per process start,
# invalidating any existing cookie). Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
WEB_UI_SECRET_KEY=
# When "false", the browser frontend (/, /login, /static/*) returns 404
# while /api/*, the SSE streams, and /mcp stay live — e.g. for a headless
# deployment (server/CI box) that only talks to this bot via the MCP tools
# or the API, never a browser.
WEB_UI_FRONTEND_ENABLED=true

# --- In-process MCP server (mounted at /mcp, same loopback-only process) ---
# Exposes watch_* (manage bot watches, in watchers.py) and session_* (search past
# Copilot session history) tools to Copilot CLI sessions run by/for this
# bot — never intended for any client outside this machine. Every request
# to /mcp must send "Authorization: Bearer <token>" matching this value.
# No fallback to WEB_UI_PASSWORD; leave unset and /mcp refuses
# all requests (500), it never silently allows unauthenticated access.
MCP_AUTH_TOKEN=

# Model routing for session_create(model=..., task_kind=...) (see README "Model routing")
# MODEL_ROUTING=on          # on (default) | dry (log only) | off (rollback: never pass model=)
# MODEL_ROUTING_CHEAP=claude-haiku-5.5
# MODEL_ROUTING_DEFAULT=    # default: model from ~/.copilot/settings.json

# Usage widget: how often the monthly Copilot quota is re-fetched (seconds, default 3600, min 60)
# QUOTA_TTL_SECONDS=3600

# --- Telegram (optional; OFF unless a token is set; see README "Telegram") ---
# TELEGRAM_BOT_TOKEN=                 # from @BotFather (or TELEGRAM_BOT_TOKEN_FILE=/path, mode 600)
# TELEGRAM_ALLOWED_USER_IDS=          # comma-separated numeric user ids; empty = Telegram stays off
# TELEGRAM_FORUM_CHAT_ID=             # -100... private forum supergroup (bot = admin, Manage Topics); empty = DM mode
# TELEGRAM_MAX_UPDATE_AGE=600         # drop messages older than this many seconds (stale backlog)
# TELEGRAM_POLL_TIMEOUT=50            # getUpdates long-poll seconds
# NEW_SESSION_PLATFORM=telegram       # new Web UI sessions also get a Telegram topic
