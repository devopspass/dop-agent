<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.dop-agent</string>
	<key>ProgramArguments</key>
	<array>
		<string>__PYTHON3_13__</string>
		<string>__DOP_AGENT_DIR__/dop_agent.py</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__DOP_AGENT_DIR__</string>
	<key>KeepAlive</key>
	<true/>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>__HOME__/.copilot/dop-agent.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/.copilot/dop-agent-error.log</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>__PATH__</string>
		<key>HOME</key>
		<string>__HOME__</string>
	</dict>
</dict>
</plist>
